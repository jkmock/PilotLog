{
  "name": "pilot-log",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @pilot-log/api dev",
    "db:up": "dbmate up",
    "db:status": "dbmate status",
    "db:rollback": "dbmate rollback",
    "db:new": "dbmate new",
    "db:dump": "dbmate dump",
    "db:seed:download": "curl -fsSL --create-dirs -o data/airports.csv https://davidmegginson.github.io/ourairports-data/airports.csv",
    "db:seed": "set -a && . ./.env && set +a && psql \"$DATABASE_URL\" -1 -f db/seeds/airports.sql"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "devDependencies": {
    "dbmate": "^2.36.0",
    "typescript": "^7.0.2"
  }
}
